diff --git a/apps/client/src/features/app-settings/panel/automations-panel/ObsOutputForm.tsx b/apps/client/src/features/app-settings/panel/automations-panel/ObsOutputForm.tsx
new file mode 100644
index 0000000..5ce9b67
--- /dev/null
+++ b/apps/client/src/features/app-settings/panel/automations-panel/ObsOutputForm.tsx
@@ -0,0 +1,147 @@
+import type { AutomationDTO, OBSStepAction } from 'ontime-types';
+import {
+  type Control,
+  type UseFormRegister,
+  type UseFormSetValue,
+  type UseFormWatch,
+  useFieldArray,
+} from 'react-hook-form';
+import { IoAdd, IoTrash } from 'react-icons/io5';
+
+import Button from '../../../../common/components/buttons/Button';
+import IconButton from '../../../../common/components/buttons/IconButton';
+import Input from '../../../../common/components/input/input/Input';
+import Select from '../../../../common/components/select/Select';
+import * as Panel from '../../panel-utils/PanelUtils';
+import type { OutputErrors } from './automationUtils';
+import TemplateInput from './template-input/TemplateInput';
+
+import style from './AutomationForm.module.scss';
+
+const stepOptions: { value: OBSStepAction; label: string; placeholder: string }[] = [
+  { value: 'preview-scene', label: 'Set preview scene', placeholder: '{{eventNow.title}}' },
+  { value: 'program-scene', label: 'Set program scene', placeholder: '{{eventNow.title}}' },
+  { value: 'transition', label: 'Set transition', placeholder: '{{eventNow.custom.transition}}' },
+  { value: 'transition-duration', label: 'Set transition duration (ms)', placeholder: '1000' },
+  { value: 'studio-transition', label: 'Take (studio mode transition)', placeholder: '' },
+  { value: 'wait', label: 'Wait (ms)', placeholder: '1000' },
+];
+
+interface ObsOutputFormProps {
+  index: number;
+  control: Control<AutomationDTO>;
+  register: UseFormRegister<AutomationDTO>;
+  setValue: UseFormSetValue<AutomationDTO>;
+  watch: UseFormWatch<AutomationDTO>;
+  rowErrors?: OutputErrors;
+}
+
+export default function ObsOutputForm({ index, control, register, setValue, watch, rowErrors }: ObsOutputFormProps) {
+  const {
+    fields: steps,
+    append,
+    remove,
+    move,
+  } = useFieldArray({
+    control,
+    name: `outputs.${index}.steps`,
+  });
+
+  return (
+    <>
+      <label>
+        OBS host
+        <Input
+          {...register(`outputs.${index}.targetIP`, { required: { value: true, message: 'Required field' } })}
+          fluid
+          placeholder='127.0.0.1'
+        />
+        <Panel.Error>{rowErrors?.targetIP?.message}</Panel.Error>
+      </label>
+      <label>
+        WebSocket port
+        <Input
+          {...register(`outputs.${index}.targetPort`, {
+            required: { value: true, message: 'Required field' },
+            setValueAs: (value) => (value === '' ? 0 : Number(value)),
+            max: { value: 65535, message: 'Port must be within range 1 - 65535' },
+            min: { value: 1, message: 'Port must be within range 1 - 65535' },
+          })}
+          fluid
+          type='number'
+          maxLength={5}
+          placeholder='4455'
+        />
+        <Panel.Error>{rowErrors?.targetPort?.message}</Panel.Error>
+      </label>
+      <label>
+        Password
+        <Input
+          {...register(`outputs.${index}.password`)}
+          fluid
+          type='password'
+          autoComplete='off'
+          placeholder='Leave empty without authentication'
+        />
+      </label>
+
+      <div className={style.spanFull}>
+        <Panel.Description>
+          Steps run in OBS one after the other. Steps whose value is empty are skipped.
+        </Panel.Description>
+      </div>
+
+      {steps.map((step, stepIndex) => {
+        const actionPath = `outputs.${index}.steps.${stepIndex}.action` as const;
+        const valuePath = `outputs.${index}.steps.${stepIndex}.value` as const;
+        const action = watch(actionPath);
+        const option = stepOptions.find((candidate) => candidate.value === action);
+        const needsValue = action !== 'studio-transition';
+
+        return (
+          <div key={step.id} className={`${style.spanFull} ${style.obsStep}`}>
+            <span className={style.obsStepIndex}>{stepIndex + 1}</span>
+            <Select<OBSStepAction>
+              value={action}
+              onValueChange={(value) => {
+                if (value === null) return;
+                setValue(actionPath, value, { shouldDirty: true });
+              }}
+              options={stepOptions.map(({ value, label }) => ({ value, label }))}
+              aria-label='OBS step'
+            />
+            {needsValue ? (
+              <TemplateInput
+                {...register(valuePath)}
+                value={watch(valuePath)}
+                fluid
+                placeholder={option?.placeholder}
+              />
+            ) : (
+              <span />
+            )}
+            <div className={style.obsStepButtons}>
+              <Button
+                variant='ghosted-white'
+                disabled={stepIndex === 0}
+                onClick={() => move(stepIndex, stepIndex - 1)}
+                aria-label='Move step up'
+              >
+                ↑
+              </Button>
+              <IconButton aria-label='Delete step' variant='ghosted-destructive' onClick={() => remove(stepIndex)}>
+                <IoTrash />
+              </IconButton>
+            </div>
+          </div>
+        );
+      })}
+
+      <div className={style.spanFull}>
+        <Button onClick={() => append({ action: 'preview-scene', value: '' })}>
+          Add step <IoAdd />
+        </Button>
+      </div>
+    </>
+  );
+}
diff --git a/apps/server/src/api-data/automation/__tests__/obs.client.test.ts b/apps/server/src/api-data/automation/__tests__/obs.client.test.ts
new file mode 100644
index 0000000..c6e53bb
--- /dev/null
+++ b/apps/server/src/api-data/automation/__tests__/obs.client.test.ts
@@ -0,0 +1,195 @@
+import type { AddressInfo } from 'node:net';
+
+import { type OBSOutput, runtimeStorePlaceholder } from 'ontime-types';
+import { WebSocketServer } from 'ws';
+
+import * as logger from '../../logs/logs.service.js';
+import { parseOutput } from '../automation.validation.js';
+import { closeOBSConnections, emitOBS, makeAuthentication, toRequests } from '../clients/obs.client.js';
+
+vi.mock('../../logs/logs.service.js', () => ({ info: vi.fn(), warning: vi.fn(), error: vi.fn() }));
+
+const store = {
+  ...runtimeStorePlaceholder,
+  eventNow: { title: 'Kam 6', custom: { Uebergang: 'Überblende', Dauer: '5000' } },
+  eventNext: { title: 'Kam 1', custom: { Uebergang: '', Dauer: '' } },
+} as unknown as typeof runtimeStorePlaceholder;
+
+describe('toRequests()', () => {
+  it('maps steps to obs-websocket requests in order, resolving templates', () => {
+    const requests = toRequests(
+      [
+        { action: 'preview-scene', value: '{{eventNow.title}}' },
+        { action: 'transition', value: '{{eventNow.custom.Uebergang}}' },
+        { action: 'transition-duration', value: '{{eventNow.custom.Dauer}}' },
+        { action: 'studio-transition', value: '' },
+        { action: 'wait', value: '{{eventNow.custom.Dauer}}' },
+        { action: 'preview-scene', value: '{{eventNext.title}}' },
+      ],
+      store,
+    );
+
+    expect(requests).toStrictEqual([
+      { requestType: 'SetCurrentPreviewScene', requestData: { sceneName: 'Kam 6' } },
+      { requestType: 'SetCurrentSceneTransition', requestData: { transitionName: 'Überblende' } },
+      { requestType: 'SetCurrentSceneTransitionDuration', requestData: { transitionDuration: 5000 } },
+      { requestType: 'TriggerStudioModeTransition' },
+      { requestType: 'Sleep', requestData: { sleepMillis: 5000 } },
+      { requestType: 'SetCurrentPreviewScene', requestData: { sceneName: 'Kam 1' } },
+    ]);
+  });
+
+  it('skips steps whose value is empty or unresolved', () => {
+    const requests = toRequests(
+      [
+        { action: 'transition', value: '{{eventNext.custom.Uebergang}}' },
+        { action: 'transition-duration', value: '{{eventNext.custom.Dauer}}' },
+        { action: 'preview-scene', value: '{{eventNow.custom.doesNotExist}}' },
+        { action: 'wait', value: '0' },
+      ],
+      store,
+    );
+    expect(requests).toStrictEqual([]);
+  });
+
+  it('clamps the transition duration to the range OBS accepts', () => {
+    const requests = toRequests(
+      [
+        { action: 'transition-duration', value: '0' },
+        { action: 'transition-duration', value: '99999' },
+      ],
+      store,
+    );
+    expect(requests.map((request) => request.requestData?.transitionDuration)).toStrictEqual([50, 20000]);
+  });
+});
+
+describe('parseOutput() with OBS outputs', () => {
+  it('accepts a valid output and defaults optional fields', () => {
+    const result = parseOutput({
+      type: 'obs',
+      targetIP: '127.0.0.1',
+      targetPort: 4455,
+      steps: [{ action: 'studio-transition' }],
+    });
+    expect(result).toStrictEqual({
+      type: 'obs',
+      targetIP: '127.0.0.1',
+      targetPort: 4455,
+      password: '',
+      steps: [{ action: 'studio-transition', value: '' }],
+    });
+  });
+
+  it('rejects unknown actions and invalid targets', () => {
+    expect(() =>
+      parseOutput({ type: 'obs', targetIP: '127.0.0.1', targetPort: 4455, steps: [{ action: 'explode' }] }),
+    ).toThrow();
+    expect(() => parseOutput({ type: 'obs', targetIP: 'not a host', targetPort: 4455, steps: [] })).toThrow();
+    expect(() => parseOutput({ type: 'obs', targetIP: '127.0.0.1', targetPort: 70000, steps: [] })).toThrow();
+  });
+});
+
+describe('emitOBS() against a simulated obs-websocket server', () => {
+  const password = 'secret';
+  const salt = 'lM1GncleQOaCu9lT1yeUZhFYnqhsLLP1G5lAGo3ixaI=';
+  const challenge = '+IxH4CnCiqpX1rM9scsNynZzbOe4KhDeYcTNS3PDaeY=';
+
+  let server: WebSocketServer;
+  let port: number;
+  let received: { op: number; d: any }[];
+
+  beforeEach(async () => {
+    received = [];
+    server = new WebSocketServer({ port: 0 });
+    await new Promise<void>((resolve) => server.on('listening', () => resolve()));
+    port = (server.address() as AddressInfo).port;
+
+    server.on('connection', (socket, request) => {
+      expect(request.headers['sec-websocket-protocol']).toBe('obswebsocket.json');
+      socket.send(
+        JSON.stringify({
+          op: 0,
+          d: { obsWebSocketVersion: '5.7.6', rpcVersion: 1, authentication: { challenge, salt } },
+        }),
+      );
+      socket.on('message', (raw) => {
+        const message = JSON.parse(raw.toString());
+        received.push(message);
+        if (message.op === 1) {
+          if (message.d.authentication !== makeAuthentication(password, salt, challenge)) {
+            socket.close(4009, 'Authentication failed.');
+            return;
+          }
+          socket.send(JSON.stringify({ op: 2, d: { negotiatedRpcVersion: 1 } }));
+        }
+        if (message.op === 8) {
+          socket.send(
+            JSON.stringify({
+              op: 9,
+              d: {
+                requestId: message.d.requestId,
+                results: message.d.requests.map((r: { requestType: string }) => ({
+                  requestType: r.requestType,
+                  requestStatus: { result: true, code: 100 },
+                })),
+              },
+            }),
+          );
+        }
+      });
+    });
+  });
+
+  afterEach(async () => {
+    closeOBSConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+    vi.mocked(logger.warning).mockClear();
+  });
+
+  const makeOutput = (overrides: Partial<OBSOutput> = {}): OBSOutput => ({
+    type: 'obs',
+    targetIP: '127.0.0.1',
+    targetPort: port,
+    password,
+    steps: [
+      { action: 'preview-scene', value: '{{eventNow.title}}' },
+      { action: 'transition', value: '{{eventNow.custom.Uebergang}}' },
+      { action: 'studio-transition', value: '' },
+    ],
+    ...overrides,
+  });
+
+  it('authenticates and sends the steps as one ordered batch', async () => {
+    emitOBS(makeOutput(), store);
+    await vi.waitFor(() => expect(received.some((m) => m.op === 8)).toBe(true));
+
+    const batch = received.find((m) => m.op === 8)!;
+    expect(batch.d.executionType).toBe(0); // SerialRealtime
+    expect(batch.d.haltOnFailure).toBe(false);
+    expect(batch.d.requests.map((r: { requestType: string }) => r.requestType)).toStrictEqual([
+      'SetCurrentPreviewScene',
+      'SetCurrentSceneTransition',
+      'TriggerStudioModeTransition',
+    ]);
+  });
+
+  it('reuses the connection for later sends', async () => {
+    emitOBS(makeOutput(), store);
+    await vi.waitFor(() => expect(received.filter((m) => m.op === 8)).toHaveLength(1));
+    emitOBS(makeOutput(), store);
+    await vi.waitFor(() => expect(received.filter((m) => m.op === 8)).toHaveLength(2));
+    expect(received.filter((m) => m.op === 1)).toHaveLength(1);
+  });
+
+  it('reports a wrong password', async () => {
+    emitOBS(makeOutput({ password: 'wrong' }), store);
+    await vi.waitFor(() =>
+      expect(logger.warning).toHaveBeenCalledWith(
+        expect.anything(),
+        'OBS send failed',
+        expect.objectContaining({ error: 'OBS authentication failed' }),
+      ),
+    );
+  });
+});
